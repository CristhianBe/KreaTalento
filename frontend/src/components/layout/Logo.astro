---
/** Logotipo oficial de Krea Talento. `claro` usa la versión blanca (para fondos azules). */
import { Image } from 'astro:assets';
import { url } from '../../lib/url';
import { sitio } from '../../data/sitio';
import logo from '../../assets/images/logo-krea-talento.png';
import logoBlanco from '../../assets/images/logo-krea-talento-blanco.png';
interface Props { claro?: boolean; class?: string }
const { claro = false, class: clase = 'h-12 w-auto' } = Astro.props;
---
<a href={url('/')} class="inline-flex shrink-0 items-center" aria-label={`${sitio.nombre}, inicio`} data-logo>
  <Image
    src={claro ? logoBlanco : logo}
    alt={sitio.nombre}
    widths={[160, 320, 480]}
    sizes="160px"
    class:list={[clase, 'transition-[height] duration-300']}
    loading="eager"
  />
</a>
