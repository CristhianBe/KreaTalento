---
/**
 * Barra lateral del panel. En escritorio es la primera columna del layout (fija al
 * hacer scroll); en móvil se abre como cajón con el botón de menú de la barra superior (`scripts/panel/menu.ts`).
 * El nombre y correo del usuario los completa `scripts/panel/sesion.ts`.
 */
import Logo from '../layout/Logo.astro';
import Icono from '../ui/Icono.astro';
import { panel, navegacionPanel, notificaciones, type SeccionPanel } from '../../data/panel';
import { url } from '../../lib/url';

interface Props { activo: SeccionPanel }
const { activo } = Astro.props;
const noLeidas = notificaciones.filter((n) => !n.leida).length;
---
<div aria-hidden="true" class="fixed inset-0 z-40 hidden bg-azul-900/40 backdrop-blur-sm lg:hidden" data-panel-fondo></div>

<aside
  id="panel-lateral"
  class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col bg-white transition-transform duration-300 data-[abierto=true]:translate-x-0 lg:sticky lg:top-0 lg:z-auto lg:h-dvh lg:w-auto lg:translate-x-0 shadow-elevada lg:shadow-none lg:transition-none dark:bg-noche-900"
  aria-label="Menú del panel"
  data-abierto="false"
>
  <div class="flex h-20 items-center justify-between px-6">
    <span class="dark:hidden"><Logo class="h-11 w-auto" /></span>
    <span class="hidden dark:inline-flex"><Logo claro class="h-11 w-auto" /></span>
    <button
      type="button"
      class="inline-flex size-10 items-center justify-center rounded-full text-azul-700 hover:bg-azul-50 lg:hidden dark:text-noche-texto dark:hover:bg-noche-800"
      aria-label={panel.cerrarMenu}
      data-panel-cerrar
    >
      <Icono nombre="cerrar" class="size-5" />
    </button>
  </div>

  <div class="flex items-center gap-3 px-6 py-6">
    <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-azul-600 text-lg font-bold text-white dark:bg-acento ring-4 ring-celeste-100 dark:ring-noche-700" aria-hidden="true" data-panel-iniciales></span>
    <div class="min-w-0">
      <p class="truncate font-bold text-azul-800 dark:text-noche-texto" data-panel-nombre></p>
      <p class="truncate text-sm text-tinta-suave dark:text-noche-suave" data-panel-correo></p>
    </div>
  </div>

  <nav class="flex-1 overflow-y-auto px-4 py-6" aria-label={panel.nombre}>
    <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-[0.14em] text-celeste-600 dark:text-celeste-300">{panel.seccionPrincipal}</p>
    <ul class="space-y-1">
      {navegacionPanel.map((item) => {
        const actual = item.id === activo;
        return (
          <li>
            <a
              href={url(item.ruta)}
              class:list={[
                'group flex items-center gap-3 rounded-xl px-3 py-2.5 text-[0.95rem] font-medium transition-colors',
                actual ? 'bg-azul-50 font-semibold text-azul-700 dark:bg-acento/15 dark:text-white' : 'text-tinta-suave hover:bg-fondo-suave hover:text-azul-700 dark:text-noche-suave dark:hover:bg-noche-800 dark:hover:text-white',
              ]}
              aria-current={actual ? 'page' : undefined}
            >
              <span
                class:list={[
                  'inline-flex size-9 shrink-0 items-center justify-center rounded-lg transition-colors',
                  actual ? 'bg-azul-600 text-white dark:bg-acento' : 'bg-fondo-suave text-azul-500 group-hover:bg-azul-50 dark:bg-noche-800 dark:text-noche-suave dark:group-hover:bg-noche-700',
                ]}
              >
                <Icono nombre={item.icono} class="size-5" />
              </span>
              <span class="flex-1">{item.etiqueta}</span>
              {item.id === 'notificaciones' && (
                <span
                  class:list={['min-w-6 rounded-full bg-celeste-500 px-2 py-0.5 text-center text-xs font-bold text-white', noLeidas === 0 && 'hidden']}
                  data-contador-notificaciones
                >
                  {noLeidas}
                </span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="space-y-1 px-4 py-5">
    <a href={url('/')} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-[0.95rem] font-medium text-tinta-suave transition-colors hover:bg-fondo-suave hover:text-azul-700 dark:text-noche-suave dark:hover:bg-noche-800 dark:hover:text-white">
      <Icono nombre="casa" class="size-5" />{panel.volverSitio}
    </a>
    <button type="button" class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-[0.95rem] font-medium text-tinta-suave transition-colors hover:bg-error-suave hover:text-error dark:text-noche-suave dark:hover:bg-error/15 dark:hover:text-error-claro" data-panel-salir>
      <Icono nombre="salir" class="size-5" />{panel.cerrarSesion}
    </button>
  </div>
</aside>
