---
/**
 * Agenda mensual. El calendario y las listas se arman en el navegador
 * (`scripts/panel/agenda.ts`) porque dependen de la fecha de hoy.
 * Las tarjetas de cita salen de la <template> de abajo.
 */
import Icono from '../ui/Icono.astro';
import { textosAgenda as textos } from '../../data/panel';
const botonIcono = 'inline-flex size-10 items-center justify-center rounded-full text-azul-700 ring-1 ring-azul-200 transition-colors hover:bg-azul-50 hover:ring-azul-400 dark:bg-noche-800 dark:text-noche-texto dark:ring-noche-700 dark:hover:ring-noche-600';
const tarjeta = 'rounded-tarjeta bg-white shadow-suave ring-1 ring-borde dark:bg-noche-850 dark:shadow-none dark:ring-noche-700';
const vacio = 'mt-4 hidden rounded-2xl bg-fondo-suave px-4 py-6 text-center text-sm text-tinta-suave dark:bg-noche-800 dark:text-noche-suave';
---
<div>
  <h1 class="text-3xl font-bold md:text-4xl">{textos.titulo}</h1>
  <p class="mt-2 text-tinta-suave dark:text-noche-suave">{textos.texto}</p>
</div>

<div class="mt-8 grid gap-6 xl:grid-cols-[1fr_22rem]" data-agenda>
  <section class:list={[tarjeta, 'p-4 md:p-6']} aria-labelledby="agenda-mes">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="agenda-mes" class="text-2xl font-bold first-letter:uppercase" aria-live="polite" data-agenda-mes></h2>
      <div class="flex items-center gap-2">
        <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold text-azul-700 ring-1 ring-azul-200 transition-colors hover:bg-azul-50 hover:ring-azul-400 dark:bg-noche-800 dark:text-noche-texto dark:ring-noche-700 dark:hover:ring-noche-600" data-agenda-hoy>{textos.hoy}</button>
        <button type="button" class={botonIcono} aria-label={textos.mesAnterior} data-agenda-anterior>
          <Icono nombre="chevron-izq" class="size-5" />
        </button>
        <button type="button" class={botonIcono} aria-label={textos.mesSiguiente} data-agenda-siguiente>
          <Icono nombre="chevron-der" class="size-5" />
        </button>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-7 gap-1.5 text-xs font-semibold text-tinta-suave md:gap-2 dark:text-noche-suave" aria-hidden="true">
      {textos.diasSemana.map((dia) => <span class="px-1 py-2 md:px-2">{dia}</span>)}
    </div>
    <!-- Alto reservado para 6 semanas (filas de 4rem / 6rem + espacios) antes de que el script
         arme el calendario: así la página no "salta" al cargar. -->
    <!-- Ventana del calendario: al acercar un día, la cuadrícula se escala dentro de ella
         (`scripts/panel/agenda.ts`). El relleno evita que se recorten los bordes y el foco. -->
    <div class="relative -m-2 overflow-hidden rounded-2xl p-2" data-agenda-ventana>
      <div class="agenda-grid grid min-h-[calc(6*4rem_+_5*0.375rem)] origin-top-left grid-cols-7 gap-1.5 md:min-h-[calc(6*6rem_+_5*0.5rem)] md:gap-2" data-agenda-grid data-ampliado="false"></div>
      <button
        type="button"
        class="agenda-volver absolute top-4 right-4 z-10 inline-flex items-center gap-2 rounded-full bg-white/90 px-4 py-2 text-sm font-semibold text-azul-700 shadow-elevada ring-1 ring-azul-200 backdrop-blur transition-colors hover:bg-white dark:bg-noche-850/90 dark:text-noche-texto dark:shadow-none dark:ring-noche-600 dark:hover:bg-noche-800"
        hidden
        data-agenda-volver
      >
        <Icono nombre="calendario" class="size-4" />{textos.volverMes}
      </button>
    </div>
    <p class="mt-4 hidden text-xs text-tinta-suave md:block dark:text-noche-suave">{textos.pistaAmpliar}</p>
  </section>

  <div class="space-y-6">
    <section class:list={[tarjeta, 'p-6']} aria-labelledby="agenda-dia">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-celeste-600 dark:text-celeste-300">{textos.programadas}</p>
      <h2 id="agenda-dia" class="mt-1 text-lg font-bold first-letter:uppercase" data-agenda-dia-titulo></h2>
      <ul class="mt-5 space-y-5" data-agenda-dia-lista></ul>
      <p class={vacio} data-agenda-dia-vacio>{textos.sinCitasDia}</p>
    </section>

    <section class:list={[tarjeta, 'p-6']} aria-labelledby="agenda-proximas">
      <h2 id="agenda-proximas" class="text-lg font-bold">{textos.proximas}</h2>
      <ul class="mt-5 space-y-5" data-agenda-proximas></ul>
      <p class={vacio} data-agenda-proximas-vacio>{textos.sinProximas}</p>
    </section>
  </div>
</div>

<!-- Cita: etiqueta de hora con línea + tarjeta con barra de color según el tipo -->
<template data-agenda-plantilla>
  <li>
    <div class="mb-2 flex items-center gap-3 text-xs font-semibold text-tinta-suave dark:text-noche-suave">
      <span class="first-letter:uppercase" data-cita-hora></span>
      <span aria-hidden="true" class="h-px flex-1 bg-borde dark:bg-noche-700"></span>
    </div>
    <article class="rounded-2xl bg-fondo-suave p-4 ring-1 ring-borde dark:bg-noche-800 dark:ring-noche-700">
      <span aria-hidden="true" class="block h-1.5 w-full rounded-full" data-cita-color></span>
      <p class="mt-3 font-semibold text-azul-800 dark:text-noche-texto" data-cita-titulo></p>
      <p class="mt-0.5 text-sm text-tinta-suave dark:text-noche-suave" data-cita-detalle></p>
      <div class="mt-3 flex items-center justify-between gap-3 border-t border-borde pt-3 text-xs font-semibold dark:border-noche-700">
        <span class="inline-flex items-center gap-1.5 text-azul-600 dark:text-celeste-300">
          <Icono nombre="reloj" class="size-3.5" /><span data-cita-rango></span>
        </span>
        <span class="text-tinta-suave dark:text-noche-suave" data-cita-duracion></span>
      </div>
    </article>
  </li>
</template>
