---
/**
 * Barra superior del panel: menú (móvil), saludo, modo noche y avatar del usuario.
 * El saludo ("Buenas noches, Sebas") y el avatar se completan con el script en línea de abajo,
 * antes de pintar, para que no se vea primero vacío.
 */
import Icono from '../ui/Icono.astro';
import { panel } from '../../data/panel';
import { claveSesion } from '../../lib/sesion';
---
<header class="sticky top-0 z-30 bg-white/85 backdrop-blur-md dark:bg-noche-900/90">
  <div class="flex h-20 items-center justify-between gap-4 px-5 md:px-8">
    <div class="flex min-w-0 items-center gap-3">
      <button
        id="boton-panel-menu"
        type="button"
        class="inline-flex size-11 shrink-0 items-center justify-center rounded-full text-azul-700 hover:bg-azul-50 lg:hidden dark:text-noche-texto dark:hover:bg-noche-800"
        aria-expanded="false"
        aria-controls="panel-lateral"
        aria-label={panel.abrirMenu}
      >
        <Icono nombre="menu" class="size-6" />
      </button>
      <p class="truncate font-display text-lg font-bold text-azul-800 md:text-xl dark:text-noche-texto" data-panel-saludo>{panel.nombre}</p>
    </div>
    <div class="flex shrink-0 items-center gap-3">
      <button
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-full text-azul-700 ring-1 ring-azul-200 transition-colors hover:bg-azul-50 hover:ring-azul-400 dark:bg-noche-850 dark:text-celeste-300 dark:ring-noche-700 dark:hover:bg-noche-800 dark:hover:ring-noche-600"
        aria-label={panel.modoNoche}
        title={panel.modoNoche}
        aria-pressed="false"
        data-panel-tema
      >
        <Icono nombre="luna" class="size-5 dark:hidden" />
        <Icono nombre="sol" class="hidden size-5 dark:block" />
      </button>
      <span class="inline-flex size-10 items-center justify-center rounded-full bg-azul-600 font-bold text-white ring-4 ring-celeste-100 dark:bg-acento dark:ring-noche-700" role="img" data-panel-iniciales></span>
    </div>
  </div>
</header>
<script is:inline define:vars={{ claveSesion, saludos: panel.saludos }}>
  // Antes de pintar: saludo según la hora y avatar con iniciales (al pasar el mouse: nombre y correo).
  try {
    const sesion = JSON.parse(sessionStorage.getItem(claveSesion) || 'null');
    if (sesion) {
      const hora = new Date().getHours();
      const saludo = hora < 12 ? saludos.manana : hora < 19 ? saludos.tarde : saludos.noche;
      const iniciales = sesion.nombre.trim().split(/\s+/).slice(0, 2).map((parte) => parte[0].toUpperCase()).join('');
      document.querySelectorAll('[data-panel-saludo]').forEach((el) => (el.textContent = `${saludo}, ${sesion.nombre}`));
      document.querySelectorAll('[data-panel-iniciales]').forEach((el) => {
        el.textContent = iniciales;
        el.title = `${sesion.nombre} · ${sesion.correo}`;
        el.setAttribute('aria-label', `${sesion.nombre} (${sesion.correo})`);
      });
    }
  } catch (e) {}
</script>
