---
/** Lista de notificaciones con filtro y "marcar como leída" (`scripts/panel/notificaciones.ts`). */
import Icono from '../ui/Icono.astro';
import { claveNotifLeidas } from '../../lib/panel';
import { notificaciones, tiposNotificacion, textosNotificaciones as textos, type TipoNotificacion } from '../../data/panel';

const estilos: Record<TipoNotificacion, { icono: string; etiqueta: string }> = {
  cita: { icono: 'bg-azul-600 text-white dark:bg-acento', etiqueta: 'bg-azul-50 text-azul-700 dark:bg-noche-800 dark:text-noche-texto' },
  mensaje: { icono: 'bg-celeste-500 text-white', etiqueta: 'bg-celeste-50 text-celeste-600 dark:bg-celeste-500/15 dark:text-celeste-300' },
  documento: { icono: 'bg-azul-100 text-azul-700 dark:bg-azul-500/25 dark:text-noche-texto', etiqueta: 'bg-azul-50 text-azul-600 dark:bg-noche-800 dark:text-celeste-300' },
  recordatorio: { icono: 'bg-celeste-100 text-celeste-600 dark:bg-celeste-500/20 dark:text-celeste-300', etiqueta: 'bg-celeste-50 text-celeste-600 dark:bg-celeste-500/15 dark:text-celeste-300' },
};
---
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold md:text-4xl">{textos.titulo}</h1>
    <p class="mt-2 text-tinta-suave dark:text-noche-suave">{textos.texto}</p>
  </div>
  <button
    type="button"
    class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-azul-700 ring-1 ring-azul-200 transition-colors duration-200 hover:bg-azul-50 hover:ring-azul-400 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-white dark:bg-noche-850 dark:text-noche-texto dark:ring-noche-700 dark:hover:bg-noche-800 dark:disabled:hover:bg-noche-850"
    data-notif-marcar-todas
  >
    <Icono nombre="check" class="size-4" />{textos.marcarTodas}
  </button>
</div>

<section class="mt-8 overflow-hidden rounded-tarjeta bg-white shadow-suave ring-1 ring-borde dark:bg-noche-850 dark:shadow-none dark:ring-noche-700" aria-label={textos.titulo}>
  <div class="flex flex-wrap gap-2 border-b border-borde px-5 py-4 md:px-6 dark:border-noche-700">
    {textos.filtros.map((filtro, i) => (
      <button
        type="button"
        class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm font-semibold text-tinta-suave transition-colors hover:bg-fondo-suave hover:text-azul-700 aria-pressed:bg-azul-600 aria-pressed:text-white dark:aria-pressed:bg-acento dark:text-noche-suave dark:hover:bg-noche-800 dark:hover:text-white"
        aria-pressed={i === 0 ? 'true' : 'false'}
        data-notif-filtro={filtro.id}
      >
        {filtro.etiqueta}
        <span class="text-xs opacity-80" data-notif-total={filtro.id}></span>
      </button>
    ))}
  </div>

  <ul class="divide-y divide-borde dark:divide-noche-700" data-notif-lista>
    {notificaciones.map((n, i) => {
      const tipo = tiposNotificacion[n.tipo];
      return (
        <li style={`--i: ${i}`} class="panel-item group flex gap-4 px-5 py-5 transition-colors duration-500 data-[leida=false]:bg-celeste-50/50 md:px-6 dark:data-[leida=false]:bg-celeste-500/10" data-notificacion={n.id} data-leida={String(n.leida)}>
          <span class:list={['inline-flex size-11 shrink-0 items-center justify-center rounded-xl', estilos[n.tipo].icono]}>
            <Icono nombre={tipo.icono} class="size-5" />
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <p class="font-semibold text-azul-800 dark:text-noche-texto">{n.titulo}</p>
              <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-semibold', estilos[n.tipo].etiqueta]}>{tipo.etiqueta}</span>
              <span class="inline-flex items-center gap-1.5 group-data-[leida=true]:hidden">
                <span aria-hidden="true" class="size-2 rounded-full bg-celeste-500"></span>
                <span class="sr-only">{textos.noLeida}</span>
              </span>
            </div>
            <p class="mt-1 text-sm text-tinta-suave dark:text-noche-suave">{n.texto}</p>
            <p class="mt-2 text-xs font-medium text-azul-400 dark:text-noche-suave">{n.cuando}</p>
          </div>
          <button
            type="button"
            class="inline-flex size-9 shrink-0 items-center justify-center self-start rounded-full text-azul-400 transition-colors hover:bg-azul-50 hover:text-azul-600 group-data-[leida=true]:hidden dark:text-noche-suave dark:hover:bg-noche-800 dark:hover:text-white"
            aria-label={textos.marcarLeida}
            title={textos.marcarLeida}
            data-notif-leer
          >
            <Icono nombre="check" class="size-4" />
          </button>
        </li>
      );
    })}
  </ul>

  <p class="hidden px-6 py-14 text-center text-tinta-suave dark:text-noche-suave" data-notif-vacio>
    <Icono nombre="campana" class="mx-auto mb-3 size-8 text-azul-200 dark:text-noche-700" />
    {textos.vacio}
  </p>
</section>

<script is:inline define:vars={{ claveNotifLeidas }}>
  // Antes de pintar: marca como leídas las que ya se leyeron en esta sesión y pone los totales
  // de los filtros (sin parpadeo). Lo demás (clics, filtros) lo maneja scripts/panel/notificaciones.ts.
  try {
    const leidas = new Set(JSON.parse(sessionStorage.getItem(claveNotifLeidas) || '[]'));
    const items = [...document.querySelectorAll('[data-notificacion]')];
    items.forEach((item) => {
      if (leidas.has(item.dataset.notificacion)) item.dataset.leida = 'true';
    });
    const noLeidas = items.filter((item) => item.dataset.leida === 'false').length;
    const totales = { todas: items.length, 'no-leidas': noLeidas };
    document.querySelectorAll('[data-notif-total]').forEach((el) => (el.textContent = String(totales[el.dataset.notifTotal])));
    const marcarTodas = document.querySelector('[data-notif-marcar-todas]');
    if (marcarTodas) marcarTodas.disabled = noLeidas === 0;
  } catch (e) {}
</script>
