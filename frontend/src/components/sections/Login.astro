---
/**
 * Pantalla de inicio de sesión. La validación y el envío están en `src/scripts/login.ts`.
 * Sin animaciones por ahora (la página usa `animaciones={false}` en BaseLayout).
 */
import Logo from '../layout/Logo.astro';
import Icono from '../ui/Icono.astro';
import { login } from '../../data/login';
import { lema } from '../../data/sitio';
import { url } from '../../lib/url';
const { campos, panel } = login;
---
<section id="login" class="relative overflow-hidden bg-gradient-to-b from-celeste-50 via-white to-white pt-32 pb-20 md:pt-40 md:pb-28">
  <div aria-hidden="true" class="pointer-events-none absolute -top-32 -right-32 size-[34rem] rounded-full bg-celeste-100/70 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute top-40 -left-40 size-[26rem] rounded-full bg-azul-100/60 blur-3xl"></div>

  <div class="contenedor relative">
    <div class="mx-auto grid max-w-4xl overflow-hidden rounded-[2rem] bg-white shadow-elevada ring-1 ring-borde lg:grid-cols-[1fr_1.1fr]">
      <aside class="relative hidden overflow-hidden bg-gradient-to-br from-azul-600 via-azul-700 to-azul-800 p-10 text-azul-100 lg:flex lg:flex-col lg:justify-between">
        <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-16 size-56 rounded-full bg-celeste-400/30 blur-2xl"></div>
        <div class="relative">
          <Logo claro class="h-14 w-auto" />
        </div>
        <div class="relative mt-16">
          <p class="font-display text-3xl font-bold text-white">{panel.titulo}</p>
          <p class="mt-3 text-lg">{panel.texto}</p>
          <p class="mt-8 text-sm font-semibold text-celeste-200">{lema}</p>
        </div>
      </aside>

      <div class="p-8 md:p-12">
        <h1 class="text-3xl font-bold md:text-4xl">{login.titulo}</h1>
        <p class="mt-3 text-tinta-suave">{login.texto}</p>

        <form class="mt-8 space-y-5" novalidate data-login>
          <div>
            <label for="correo" class="mb-2 block text-sm font-semibold text-azul-800">{campos.correo.etiqueta}</label>
            <div class="relative">
              <Icono nombre="correo" class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-azul-300" />
              <input
                id="correo"
                name="correo"
                type="email"
                inputmode="email"
                autocomplete="email"
                placeholder={campos.correo.placeholder}
                required
                class="campo pl-12"
                aria-describedby="error-correo"
                data-login-campo
              />
            </div>
            <p id="error-correo" class="mt-2 hidden text-sm font-medium text-error" data-login-error="correo"></p>
          </div>

          <div>
            <label for="contrasena" class="mb-2 block text-sm font-semibold text-azul-800">{campos.contrasena.etiqueta}</label>
            <div class="relative">
              <Icono nombre="candado" class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-azul-300" />
              <input
                id="contrasena"
                name="contrasena"
                type="password"
                autocomplete="current-password"
                placeholder={campos.contrasena.placeholder}
                required
                class="campo pr-14 pl-12"
                aria-describedby="error-contrasena"
                data-login-campo
              />
              <button
                type="button"
                class="absolute top-1/2 right-2 inline-flex size-10 -translate-y-1/2 items-center justify-center rounded-full text-azul-400 transition-colors hover:bg-azul-50 hover:text-azul-600"
                aria-label={login.verContrasena}
                aria-controls="contrasena"
                aria-pressed="false"
                data-login-ver
              >
                <Icono nombre="ojo" class="size-5 icono-mostrar" />
                <Icono nombre="ojo-cerrado" class="size-5 icono-ocultar hidden" />
              </button>
            </div>
            <p id="error-contrasena" class="mt-2 hidden text-sm font-medium text-error" data-login-error="contrasena"></p>
          </div>

          <p role="status" aria-live="polite" class="hidden rounded-2xl bg-error-suave px-5 py-4 text-sm font-medium text-error ring-1 ring-error/20" data-login-estado></p>

          <button
            type="submit"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-azul-600 px-6 py-3.5 text-[0.95rem] font-semibold text-white shadow-suave transition-colors duration-200 hover:bg-azul-700 disabled:cursor-wait disabled:bg-azul-400"
            data-login-enviar
          >
            <span data-login-enviar-texto>{login.enviar}</span>
            <Icono nombre="flecha" class="size-4" />
          </button>
        </form>

        <a href={url('/')} class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-azul-600 transition-colors hover:text-azul-700">
          <Icono nombre="flecha" class="size-4 rotate-180" />{login.volver}
        </a>
      </div>
    </div>
  </div>
</section>
