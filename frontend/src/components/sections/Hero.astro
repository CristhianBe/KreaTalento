---
import Boton from '../ui/Boton.astro';
import Icono from '../ui/Icono.astro';
import TextoRotativo from '../ui/TextoRotativo.astro';
import { hero } from '../../data/sitio';
import { servicios } from '../../data/servicios';
---
<section id="inicio" class="relative overflow-hidden bg-gradient-to-b from-celeste-50 via-white to-white pt-36 pb-20 md:pt-44 md:pb-28" data-hero>
  <div aria-hidden="true" class="aurora pointer-events-none absolute inset-x-0 top-0 h-[38rem]">
    <span></span><span></span><span></span>
  </div>
  <div aria-hidden="true" class="pointer-events-none absolute -top-32 -right-32 size-[34rem] rounded-full bg-celeste-100/70 blur-3xl" data-hero-orbe data-profundidad="40"></div>
  <div aria-hidden="true" class="pointer-events-none absolute top-40 -left-40 size-[26rem] rounded-full bg-azul-100/60 blur-3xl" data-hero-orbe data-profundidad="-30"></div>

  <div class="contenedor relative grid items-center gap-14 lg:grid-cols-[1.15fr_1fr]">
    <div>
      <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-sm font-medium text-azul-600 ring-1 ring-azul-100" data-hero-item>
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-celeste-400 opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-celeste-400"></span>
        </span>
        <span class="texto-brillante">{hero.antetitulo}</span>
      </p>
      <h1 class="text-4xl font-extrabold sm:text-5xl lg:text-6xl" data-hero-titulo>{hero.titulo}</h1>
      <p class="mt-6 text-xl font-semibold text-azul-800 md:text-2xl" data-hero-item>
        {hero.rotativo.prefijo} <TextoRotativo palabras={hero.rotativo.palabras} />
      </p>
      <p class="mt-6 max-w-xl text-lg text-tinta-suave md:text-xl" data-hero-item>{hero.texto}</p>
      <div class="mt-9 flex flex-wrap gap-4" data-hero-item>
        <Boton href="#contacto" estrella>{hero.ctaPrincipal} <Icono nombre="flecha" class="size-4" /></Boton>
        <Boton href="#servicios" variante="secundario">{hero.ctaSecundario}</Boton>
      </div>
    </div>

    <div class="relative">
      <!-- Motivo del logo: tres nodos unidos por un arco -->
      <svg aria-hidden="true" viewBox="0 0 400 220" class="pointer-events-none absolute -top-24 left-1/2 w-[120%] -translate-x-1/2 opacity-70" data-hero-red>
        <path d="M60 170 Q200 -10 340 170" fill="none" stroke="var(--color-azul-200)" stroke-width="3" stroke-linecap="round" data-red-trazo />
        <circle cx="200" cy="80" r="18" fill="var(--color-azul-300)" data-red-nodo />
        <circle cx="60" cy="170" r="14" fill="var(--color-azul-400)" data-red-nodo />
        <circle cx="340" cy="170" r="14" fill="var(--color-azul-400)" data-red-nodo />
      </svg>
      <ul class="relative grid gap-3" aria-label="Resumen de servicios">
        {servicios.map((s) => (
          <li data-hero-tarjeta>
            <button
              type="button"
              class="group flex w-full items-center gap-4 rounded-2xl bg-white/90 p-4 text-left shadow-suave ring-1 ring-borde backdrop-blur transition-[box-shadow,transform,ring-color] duration-300 hover:-translate-x-1 hover:shadow-elevada hover:ring-celeste-300"
              aria-haspopup="dialog"
              aria-controls={`dialogo-${s.id}`}
              data-abrir-servicio={s.id}
            >
              <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-celeste-50 text-azul-600 transition-colors duration-300 group-hover:bg-azul-600 group-hover:text-white">
                <Icono nombre={s.icono} />
              </span>
              <span class="flex-1">
                <span class="block font-semibold text-azul-800">{s.titulo}</span>
                <span class="block text-sm text-tinta-suave">{s.publico}</span>
              </span>
              <Icono nombre="flecha" class="size-4 text-azul-300 transition-[transform,color] duration-300 group-hover:translate-x-1 group-hover:text-azul-600" />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
