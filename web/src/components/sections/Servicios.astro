---
import EncabezadoSeccion from '../ui/EncabezadoSeccion.astro';
import Icono from '../ui/Icono.astro';
import { servicios, notaServicios } from '../../data/servicios';
---
<section id="servicios" class="seccion bg-fondo-suave">
  <div class="contenedor">
    <EncabezadoSeccion
      antetitulo="Servicios"
      titulo="Soluciones de recursos humanos a tu medida"
      texto="Para pymes que quieren ordenar y fortalecer su gestión de personas, y para profesionales que buscan dar su siguiente paso."
    />
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {servicios.map((s) => (
        <li id={s.id} class="group flex flex-col rounded-tarjeta bg-white p-7 ring-1 ring-borde shadow-suave transition-shadow duration-300 hover:shadow-elevada" data-reveal>
          <div class="flex items-start justify-between gap-4">
            <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-azul-600 text-white transition-colors duration-300 group-hover:bg-celeste-500">
              <Icono nombre={s.icono} />
            </span>
            <span class="rounded-full bg-celeste-50 px-3 py-1 text-xs font-semibold text-celeste-600">{s.publico}</span>
          </div>
          <h3 class="mt-6 text-xl font-bold">{s.titulo}</h3>
          <p class="mt-2 text-tinta-suave">{s.resumen}</p>
          <ul class="mt-5 space-y-2 border-t border-borde pt-5 text-sm">
            {s.incluye.map((i) => (
              <li class="flex gap-2"><Icono nombre="check" class="mt-0.5 size-4 shrink-0 text-celeste-500" />{i}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
    <p class="mx-auto mt-12 max-w-2xl text-center text-tinta-suave" data-reveal>{notaServicios}</p>
  </div>
</section>
