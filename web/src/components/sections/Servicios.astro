---
import EncabezadoSeccion from '../ui/EncabezadoSeccion.astro';
import Icono from '../ui/Icono.astro';
import { servicios, notaServicios } from '../../data/servicios';
---
<section id="servicios" class="seccion relative overflow-hidden bg-fondo-suave">
  <div aria-hidden="true" class="pointer-events-none absolute top-1/3 -left-40 size-[30rem] rounded-full bg-celeste-100/60 blur-3xl" data-parallax="-80"></div>
  <div class="contenedor relative">
    <EncabezadoSeccion
      antetitulo="Servicios"
      titulo="Soluciones de recursos humanos a tu medida"
      texto="Elige un servicio para conocer más."
    />

    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 [perspective:1200px]" data-servicios>
      {servicios.map((s) => (
        <li data-servicio-tarjeta>
          <button
            type="button"
            class="tarjeta-servicio group relative flex h-full w-full flex-col overflow-hidden rounded-tarjeta bg-white p-7 text-left ring-1 ring-borde shadow-suave transition-[box-shadow,ring-color] duration-300 hover:shadow-elevada hover:ring-celeste-300"
            aria-haspopup="dialog"
            aria-controls={`dialogo-${s.id}`}
            data-abrir-servicio={s.id}
          >
            <span aria-hidden="true" class="foco pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>
            <span class="relative flex items-start justify-between gap-4">
              <span class="inline-flex size-14 items-center justify-center rounded-2xl bg-azul-600 text-white transition-[background-color,transform] duration-500 group-hover:-rotate-6 group-hover:scale-110 group-hover:bg-celeste-500">
                <Icono nombre={s.icono} class="size-7" />
              </span>
              <span class="rounded-full bg-celeste-50 px-3 py-1 text-xs font-semibold text-celeste-600">{s.publico}</span>
            </span>
            <span class="relative mt-7 block font-display text-2xl font-bold text-azul-800">{s.titulo}</span>
            <span class="relative mt-2 block text-tinta-suave">{s.gancho}</span>
            <span class="relative mt-auto inline-flex items-center gap-2 pt-7 text-sm font-semibold text-azul-600">
              Ver detalles
              <span class="inline-flex size-7 items-center justify-center rounded-full bg-azul-50 transition-[transform,background-color,color] duration-300 group-hover:translate-x-1 group-hover:bg-azul-600 group-hover:text-white">
                <Icono nombre="flecha" class="size-3.5" />
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>
    <p class="mx-auto mt-12 max-w-2xl text-center text-tinta-suave" data-reveal>{notaServicios}</p>
  </div>

  {servicios.map((s) => (
    <dialog
      id={`dialogo-${s.id}`}
      class="dialogo-servicio m-auto w-[min(36rem,calc(100%-2rem))] max-h-[calc(100dvh-2rem)] overflow-y-auto overscroll-contain rounded-[1.75rem] bg-white p-0 text-tinta shadow-elevada"
      aria-labelledby={`titulo-${s.id}`}
      data-lenis-prevent
    >
      <div class="relative overflow-hidden bg-gradient-to-br from-azul-600 via-azul-700 to-azul-800 px-8 pt-8 pb-10 text-white" data-dialogo-cabecera>
        <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-16 size-56 rounded-full bg-celeste-400/30 blur-2xl"></div>
        <button type="button" class="absolute top-4 right-4 inline-flex size-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20" aria-label="Cerrar" data-cerrar-servicio>
          <Icono nombre="cerrar" class="size-5" />
        </button>
        <span class="relative inline-flex size-14 items-center justify-center rounded-2xl bg-white/15 ring-1 ring-white/25" data-dialogo-item>
          <Icono nombre={s.icono} class="size-7" />
        </span>
        <p class="relative mt-5 text-sm font-semibold uppercase tracking-[0.14em] text-celeste-200" data-dialogo-item>{s.publico}</p>
        <h3 id={`titulo-${s.id}`} class="relative mt-1 text-3xl font-bold text-white" data-dialogo-item>{s.titulo}</h3>
      </div>
      <div class="px-8 pt-7 pb-8">
        <p class="text-lg text-tinta-suave" data-dialogo-item>{s.detalle}</p>
        <p class="mt-6 text-sm font-semibold uppercase tracking-[0.12em] text-azul-600" data-dialogo-item>Incluye</p>
        <ul class="mt-3 space-y-3">
          {s.incluye.map((i) => (
            <li class="flex gap-3" data-dialogo-item>
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-celeste-50 text-celeste-600">
                <Icono nombre="check" class="size-3.5" />
              </span>
              {i}
            </li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3" data-dialogo-item>
          <a href="#contacto" class="inline-flex items-center gap-2 rounded-full bg-azul-600 px-6 py-3 text-[0.95rem] font-semibold text-white transition-colors hover:bg-azul-700" data-cerrar-servicio>
            Solicitar propuesta <Icono nombre="flecha" class="size-4" />
          </a>
        </div>
      </div>
    </dialog>
  ))}
</section>
