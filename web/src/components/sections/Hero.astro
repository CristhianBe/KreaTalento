---
import Boton from '../ui/Boton.astro';
import Icono from '../ui/Icono.astro';
import { hero } from '../../data/sitio';
import { servicios } from '../../data/servicios';
---
<section id="inicio" class="relative overflow-hidden bg-gradient-to-b from-celeste-50 via-white to-white pt-36 pb-20 md:pt-44 md:pb-28">
  <div aria-hidden="true" class="pointer-events-none absolute -top-32 -right-32 size-[34rem] rounded-full bg-celeste-100/70 blur-3xl" data-hero-orbe></div>
  <div aria-hidden="true" class="pointer-events-none absolute top-40 -left-40 size-[26rem] rounded-full bg-azul-100/60 blur-3xl" data-hero-orbe></div>

  <div class="contenedor relative grid items-center gap-14 lg:grid-cols-[1.15fr_1fr]">
    <div>
      <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-sm font-medium text-azul-600 ring-1 ring-azul-100" data-hero-item>
        <span class="size-2 rounded-full bg-celeste-400"></span>{hero.antetitulo}
      </p>
      <h1 class="text-4xl font-extrabold sm:text-5xl lg:text-6xl" data-hero-item>{hero.titulo}</h1>
      <p class="mt-6 max-w-xl text-lg text-tinta-suave md:text-xl" data-hero-item>{hero.texto}</p>
      <div class="mt-9 flex flex-wrap gap-4" data-hero-item>
        <Boton href="#contacto">{hero.ctaPrincipal} <Icono nombre="flecha" class="size-4" /></Boton>
        <Boton href="#servicios" variante="secundario">{hero.ctaSecundario}</Boton>
      </div>
    </div>

    <ul class="grid gap-3" aria-label="Resumen de servicios">
      {servicios.map((s) => (
        <li class="flex items-center gap-4 rounded-2xl bg-white/90 p-4 shadow-suave ring-1 ring-borde" data-hero-tarjeta>
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-celeste-50 text-azul-600">
            <Icono nombre={s.icono} />
          </span>
          <span>
            <span class="block font-semibold text-azul-800">{s.titulo}</span>
            <span class="block text-sm text-tinta-suave">{s.publico}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
