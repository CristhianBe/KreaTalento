---
/** Logotipo provisional en texto (el logo oficial trae verde/coral: pendiente de decisión). */
import { url } from '../../lib/url';
import { sitio } from '../../data/sitio';
interface Props { claro?: boolean }
const { claro = false } = Astro.props;
---
<a href={url('/')} class="inline-flex items-center gap-2.5" aria-label={`${sitio.nombre}, inicio`}>
  <span class:list={['inline-flex size-9 items-center justify-center rounded-xl text-sm font-bold', claro ? 'bg-white text-azul-700' : 'bg-azul-600 text-white']}>KT</span>
  <span class:list={['text-lg font-bold tracking-tight', claro ? 'text-white' : 'text-azul-800']}>
    Krea <span class={claro ? 'text-celeste-200' : 'text-celeste-500'}>Talento</span>
  </span>
</a>
