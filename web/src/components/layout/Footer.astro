---
import Logo from './Logo.astro';
import Icono from '../ui/Icono.astro';
import { sitio, navegacion } from '../../data/sitio';
import { contacto } from '../../data/contacto';
const redes = Object.entries(contacto.redes).filter(([, enlace]) => enlace);
const anio = new Date().getFullYear();
---
<footer class="bg-azul-800 text-azul-100">
  <div class="contenedor grid gap-10 py-14 md:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <Logo claro />
      <p class="mt-4 max-w-sm text-sm text-azul-200">{sitio.lema}.</p>
    </div>
    <nav aria-label="Pie de página">
      <p class="mb-3 text-sm font-semibold text-white">Navegación</p>
      <ul class="space-y-2 text-sm">
        {navegacion.map((item) => <li><a href={item.href} class="hover:text-white">{item.etiqueta}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="mb-3 text-sm font-semibold text-white">Contacto</p>
      <ul class="space-y-2 text-sm">
        {contacto.correo && <li><a href={`mailto:${contacto.correo}`} class="hover:text-white">{contacto.correo}</a></li>}
        {contacto.ubicacion && <li>{contacto.ubicacion}</li>}
      </ul>
      {redes.length > 0 && (
        <ul class="mt-4 flex gap-3">
          {redes.map(([red, enlace]) => (
            <li>
              <a href={enlace} target="_blank" rel="noopener noreferrer" aria-label={red} class="inline-flex size-9 items-center justify-center rounded-full bg-azul-700 hover:bg-azul-600 hover:text-white">
                <Icono nombre={red} class="size-4" />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
  <div class="border-t border-azul-700">
    <p class="contenedor py-5 text-xs text-azul-300">© {anio} {sitio.nombre}. Todos los derechos reservados.</p>
  </div>
</footer>
