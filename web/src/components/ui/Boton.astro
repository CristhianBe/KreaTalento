---
interface Props {
  href: string;
  variante?: 'primario' | 'secundario' | 'claro';
  externo?: boolean;
  class?: string;
  [atributo: string]: unknown;
}
const { href, variante = 'primario', externo = false, class: clase = '', ...resto } = Astro.props;
const estilos = {
  primario: 'bg-azul-600 text-white hover:bg-azul-700 shadow-suave',
  secundario: 'bg-white text-azul-700 ring-1 ring-azul-200 hover:ring-azul-400 hover:bg-azul-50',
  claro: 'bg-white text-azul-700 hover:bg-celeste-50 shadow-suave',
};
---
<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-[0.95rem] font-semibold transition-colors duration-200',
    estilos[variante],
    clase,
  ]}
  data-magnetico
  {...(externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  {...resto}
>
  <slot />
</a>
