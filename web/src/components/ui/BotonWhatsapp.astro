---
import Icono from './Icono.astro';
import { enlaceWhatsapp } from '../../data/contacto';
const enlace = enlaceWhatsapp();
---
{enlace && (
  <a
    href={enlace}
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-5 right-5 z-40 inline-flex size-14 items-center justify-center rounded-full bg-celeste-500 text-white shadow-elevada transition-transform duration-200 hover:scale-105 hover:bg-celeste-600"
    aria-label="Escríbenos por WhatsApp"
  >
    <Icono nombre="whatsapp" class="size-7" />
  </a>
)}
